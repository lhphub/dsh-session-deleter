{
  "name": "@local/dsh-session-deleter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Permanently deletes a conversation from its row menu and cleans up its log, projection cache, and workspace accounting.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-context-menu"
      ]
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lhphub/dsh-session-deleter.git"
  },
  "homepage": "https://github.com/lhphub/dsh-session-deleter",
  "bugs": {
    "url": "https://github.com/lhphub/dsh-session-deleter/issues"
  },
  "author": "lhphub"
}
